# FounderShield AI — environment variable template
# PLACEHOLDERS ONLY. Never commit real secrets. Copy to .env and fill locally.
# .env must be gitignored.

# ---- Backend: core ----
APP_ENV=development                 # development | test | production
LOG_LEVEL=info
# Comma-separated explicit allowlist. No wildcards in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Supabase (Phase 02) ----
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key-placeholder
# Server-side only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
# Supabase JWT secret for verifying auth tokens (server-side only).
SUPABASE_JWT_SECRET=your-jwt-secret-placeholder

# ---- Reasoning / LLM provider (Phase 06) ----
# One configurable provider behind an interface. Default to mock in dev.
LLM_PROVIDER=mock                   # mock | <real-provider-id-TBD>
LLM_API_KEY=your-llm-api-key-placeholder
LLM_MODEL=your-model-id-placeholder
LLM_MAX_OUTPUT_TOKENS=2048

# ---- Voice provider (Phase 05) ----
# Mock by default. Real provider selected after doc verification.
VOICE_PROVIDER=mock                 # mock (default) | smallest (verified)
# Provider-specific keys are added ONLY after verifying the official docs.
# Do not invent variable names before Phase 05.
VOICE_API_KEY=your-voice-api-key-placeholder
# Smallest AI Atoms agent id (required when VOICE_PROVIDER=smallest).
VOICE_AGENT_ID=your-agent-id-placeholder

# ---- Privacy / retention (Phase 02/03) ----
INTERVIEW_RETENTION_DAYS=30
STORE_RAW_TRANSCRIPTS=false         # must stay false by default

# ---- Frontend (Vite) ----
# Only non-secret, public-safe values may be exposed to the browser.
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-placeholder

# ---- Persistence backend (Phase 02) ----
DATABASE_BACKEND=memory          # memory | supabase (production requires supabase)
ALLOW_DEV_AUTH=false             # dev-only header auth; MUST be false in production
